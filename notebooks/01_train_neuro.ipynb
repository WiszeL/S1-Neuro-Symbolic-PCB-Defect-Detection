    "if not use_checkpoint:\n",
    "    artifacts = next_run_artifacts(Path(\"checkpoints\") / \"neuro\")\n",
    "\n",
    "    checkpoint_payload = {\n",
    "        \"model_state_dict\": model.state_dict(),\n",
